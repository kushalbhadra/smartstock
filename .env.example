POSTGRES_USER=smartstock
POSTGRES_PASSWORD=replace-with-a-long-random-secret

# Public browser origin(s), comma-separated; do not include paths.
APP_CORS_ALLOWED_ORIGINS=http://localhost,https://your-domain.example
VITE_API_BASE_URL=http://localhost:8080

# Initial administrator; created only when the database has no admin.
SMARTSTOCK_BOOTSTRAP_ADMIN_NAME=Workspace Administrator
SMARTSTOCK_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SMARTSTOCK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-12-plus-characters

# Keep real credentials out of source control.
GROQ_API_KEY=replace-me
JWT_SECRET=replace-with-at-least-32-random-bytes
